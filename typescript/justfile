# `@hajer/sdk` — the TypeScript client. Dev tools are exact-pinned in package.json / package-lock.json.

# List all recipes
default:
    @just --list

# Install the exact-pinned dev tools
sync:
    npm ci

# Every gate, in the order a failure is cheapest to read: the generated wire first (a stale wire makes
# every type error downstream a lie), then the type checker, then the tests.
check: check-wire typecheck

# `src/wire.ts` is what `contract/openapi.json` produces.
check-wire:
    node scripts/generate_wire_ts.mjs --check

# TypeScript, strict.
typecheck:
    npx tsc --noEmit -p tsconfig.json

# vitest, once. Fakes only: nothing here opens a socket or spends money.
test *ARGS:
    npx vitest run {{ARGS}}

# What CI runs
ci: check test

# Regenerate `src/wire.ts` after `contract/openapi.json` moves. `src/rules.ts` and `src/checksums.ts`
# are generated from the platform's redaction catalog, in the platform repository (`contract/README.md`).
generate-wire:
    node scripts/generate_wire_ts.mjs --write
