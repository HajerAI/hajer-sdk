{
  "name": "@hajer/sdk",
  "version": "0.1.0",
  "description": "Hajer's TypeScript client: verify, observe and attach.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src"
  ],
  "peerDependencies": {
    "@anthropic-ai/sdk": "*",
    "openai": "*"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "generate-wire": "node scripts/generate_wire_ts.mjs --write",
    "check-wire": "node scripts/generate_wire_ts.mjs --check"
  }
}
