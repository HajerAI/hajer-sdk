{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Relative imports name `.ts` because `node --experimental-strip-types` runs this source
    // directly — the fixture application (`fixture-app.ts`) is the file a reader opens,
    // not a build artefact — and Node's type stripping does not rewrite a `.js` specifier back to
    // the `.ts` beside it.
    "allowImportingTsExtensions": true,
    // Node's strip-only mode erases types and does not transform: a parameter property or an enum
    // compiles under tsc and dies at `node --experimental-strip-types`. This flag moves that from a
    // runtime crash in the fixture application to a type error in `just check`.
    "erasableSyntaxOnly": true,
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src", "test"]
}
