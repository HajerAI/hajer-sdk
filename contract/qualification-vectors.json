{
  "$comment": "Shared vectors for the qualification rule. The Hajer platform and the SDK's pytest plugin read them. Labels only: nothing passes, fails or blocks on a label, and a qualified label says the verdict settled, not that it is S.",
  "rule": "qualification-rule-v1",
  "maxRepeats": 5,
  "minAgreeing": 3,
  "symbols": {
    "S": "SATISFIES: the check held on this attempt (the plugin's PASS)",
    "V": "VIOLATES: the check was violated on this attempt (the plugin's FAIL)",
    "U": "UNKNOWN: any other reading (unscored, UNABLE_TO_VERIFY, or a replay whose request no longer matches its recording). It spends an attempt and never counts toward agreement"
  },
  "labels": {
    "qualified": "at least minAgreeing (3) counted attempts, all equal, S or V",
    "not_yet": "neither qualified nor flaky",
    "flaky": "both S and V appear among the attempts"
  },
  "repeat": "true when another attempt is due: the label is not_yet and fewer than maxRepeats attempts were made",
