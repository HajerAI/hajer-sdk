{
  "$comment": "Shared vectors for how a KEYED input-situation choice is witnessed on a case's request. The Hajer platform and the SDK's CI evaluator (hajer.pytest_plugin) must give every vector the same answer.",
  "ops": [
    "EMPTY",
    "NON_EMPTY",
    "LENGTH_AT_MOST",
    "LENGTH_EQUALS",
    "LENGTH_ABOVE",
    "CONTAINS_ANY",
    "CONTAINS_NONE"
  ],
  "semantics": {
    "field": "a path is read whole from the request, never a suffix; when its parent is not an object of the request the witness is UNKNOWN (null), never empty; a missing leaf under a present parent is ABSENT; [] is the whole request",
    "empty": "ABSENT, null, a whitespace-only string, an empty list or object",
    "length": "a string's code points, a list's items, an object's keys; ABSENT and null 0; other scalars the length of their JSON text",
    "text": "a string itself; a list's or object's string leaves joined by a newline, in order; other values the empty string",
    "contains": "case-folded substring of the text"
  },
