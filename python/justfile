# Keep commands on the installed locked environment: `uv run` never syncs behind your back, so the
# environment a gate ran against is the one `just sync` put there.
export UV_NO_SYNC := "1"

# List all recipes
default:
    @just --list

# Install / sync dependencies. This is a customer's first command, so it has to work in a clean
# checkout. It carried `--no-build` for wheel-only dependency hygiene and that refused the *project*:
# `hajer==0.1.0 @ editable+.` has no binary distribution because it is the thing being built, and uv
# has no way to say "no builds except mine". A failed sync then cascaded — `UV_NO_SYNC=1` above means
# the next `just check` cannot find ruff at all. Every dependency in `uv.lock` publishes wheels, so
# the flag was buying nothing that a locked resolution does not already give.
# `--all-extras`: the provider-surface and fail-safe tests import the real `openai`, `anthropic` and OpenTelemetry
# SDK and skip without them, so a gate run on a bare sync passed with 232 of them skipped.
sync:
    uv sync --locked --all-extras

# Format with ruff
fmt:
    uv run ruff format hajer tests scripts examples

# Lint and auto-fix with ruff
lint:
    uv run ruff check hajer tests scripts examples --fix

# Type check with basedpyright (strict, no `Any`)
typecheck:
    uv run basedpyright

# Dead-code scan with vulture
deadcode:
    uv run vulture

# Dependency hygiene with deptry (unused / missing / transitive imports)
deps:
    uv run deptry .

# Fail if uv.lock is out of date with pyproject.toml
lock-check:
    uv lock --check

# Run every quality gate
check: fmt lint typecheck deadcode deps lock-check

# Run the test suite (pass extra pytest args, e.g. `just test -k wrap`)
test *args:
    uv run pytest {{ args }}

# Build the sdist and wheel into dist/
build:
    uv build --out-dir dist

# Pin the eval engine to one exact upstream promptfoo version: rewrites hajer/evals/engine/package.json and
# regenerates its package-lock.json (`--package-lock-only`, so a lock made here records every platform's optional
# packages and `npm ci` installs it on Linux CI too). Needs Node >= 22.22 and npm on PATH; then run the golden
# test (`just test --engine -m engine`) and note the bump in CHANGELOG.md and on docs.hajer.ai (docs/evals/engine.md in HajerAI/hajer-docs).
evals-pin version:
    cd hajer/evals/engine && node -e "const p=require('./package.json'); p.dependencies.promptfoo='{{ version }}'; require('fs').writeFileSync('package.json', JSON.stringify(p, null, 2) + '\n')"
    cd hajer/evals/engine && rm -f package-lock.json && npm install --package-lock-only --ignore-scripts --no-audit --no-fund --loglevel=error
    uv run python -c "import hajer.evals._engine as e; print('pinned', e.pinned().version)"

# Install the pinned eval engine into the cache without running an eval (what the first `hajer eval` does).
evals-engine:
    uv run hajer eval --install-only

# What CI runs: non-mutating checks + tests
ci:
    uv lock --check
    uv run ruff format --check hajer tests scripts examples
    uv run ruff check hajer tests scripts examples
    just typecheck deadcode deps
    just test
